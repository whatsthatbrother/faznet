<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of Faznet goes to a cloud backup or to another device (playlists hold account passwords,
     and the MAC/PIN belongs to this device). Same as allowBackup="false" on older versions. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
