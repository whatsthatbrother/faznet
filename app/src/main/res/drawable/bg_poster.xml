<?xml version="1.0" encoding="utf-8"?>
<!-- Poster frame: rounded, a soft white edge only when focused (Apple TV lifts the poster, no thick frame) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#2C2C2E" /><stroke android:width="2dp" android:color="#E6FFFFFF" /><corners android:radius="12dp" /></shape>
    </item>
    <item><shape><solid android:color="#1C1C1E" /><corners android:radius="12dp" /></shape></item>
</selector>
