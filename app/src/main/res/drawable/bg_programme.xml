<?xml version="1.0" encoding="utf-8"?>
<!-- Guide rows (tvOS): white when focused; the programme on air a little lighter -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#F2F2F7" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#3A3A3C" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="#2C2C2E" /><corners android:radius="14dp" /></shape>
    </item>
    <item><shape><solid android:color="#1C1C1E" /><corners android:radius="14dp" /></shape></item>
</selector>
