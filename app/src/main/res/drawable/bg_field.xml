<?xml version="1.0" encoding="utf-8"?>
<!-- Text field (tvOS): a rounded grey field, a white edge when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#48484A" /><stroke android:width="2dp" android:color="#FFFFFF" /><corners android:radius="14dp" /></shape>
    </item>
    <item><shape><solid android:color="#3A3A3C" /><corners android:radius="14dp" /></shape></item>
</selector>
