<?xml version="1.0" encoding="utf-8"?>
<!-- Sidebar rows (tvOS): white when focused, a faint grey for the open one -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#F2F2F7" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="#1FFFFFFF" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/surface2" /><corners android:radius="12dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@android:color/transparent" /><corners android:radius="12dp" /></shape>
    </item>
</selector>
