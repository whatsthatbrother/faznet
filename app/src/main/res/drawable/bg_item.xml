<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/focus_bg" /><stroke android:width="2dp" android:color="@color/accent" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="@color/surface2" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/surface" /><corners android:radius="10dp" /></shape>
    </item>
</selector>
