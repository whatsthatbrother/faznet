<?xml version="1.0" encoding="utf-8"?>
<!-- A list row (tvOS): grey, white when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#F2F2F7" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#3A3A3C" /><corners android:radius="14dp" /></shape>
    </item>
    <item><shape><solid android:color="#1C1C1E" /><corners android:radius="14dp" /></shape></item>
</selector>
