<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Faznet" parent="Theme.Material3.Dark.NoActionBar">
        <!-- targetSdk 35: until the screens handle system bars themselves, Android 15 phones must not draw under them -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/accent2</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <!-- Dialogs, buttons and switches in the same blue-violet look (no default Material purple) -->
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_dim</item>
        <item name="colorSurfaceVariant">@color/surface2</item>
        <item name="colorSurfaceContainerLowest">@color/bg</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/dialog_bg</item>
        <item name="colorSurfaceContainerHighest">@color/surface2</item>
        <item name="colorPrimaryContainer">@color/surface2</item>
        <item name="colorOnPrimaryContainer">@color/text</item>
        <item name="colorSecondaryContainer">@color/accent</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>
        <item name="colorTertiary">@color/accent2</item>
        <item name="colorOutline">@color/line</item>
        <!-- Clickable things stand out: filled blue buttons, white when focused with the remote -->
        <item name="materialButtonStyle">@style/Faznet.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Faznet.Button.Secondary</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Faznet.Dialog</item>
        <!-- Text fields and choices are made with the screen's context, also inside dialogs: the look lives here -->
        <item name="editTextStyle">@style/Faznet.EditText</item>
        <item name="radioButtonStyle">@style/Faznet.Choice.Radio</item>
        <item name="checkboxStyle">@style/Faznet.Choice.Check</item>
        <!-- Short cross-fades between screens instead of the slow default slide -->
        <item name="android:windowAnimationStyle">@style/Faznet.WindowAnim</item>
        <item name="colorControlHighlight">#550A84FF</item>
    </style>

    <style name="Faznet.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/btn_bg</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="iconTint">@color/btn_text</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Faznet.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/btn2_bg</item>
        <item name="android:textColor">@color/btn2_text</item>
        <item name="iconTint">@color/btn2_text</item>
        <item name="strokeColor">@color/btn2_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Faznet.DialogButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">22dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">46dp</item>
        <item name="backgroundTint">@color/btn_bg</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:layout_marginStart">8dp</item>
    </style>

    <style name="Faznet.DialogButton.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">22dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">46dp</item>
        <item name="backgroundTint">@color/btn2_bg</item>
        <item name="android:textColor">@color/btn2_text</item>
        <item name="strokeColor">@color/btn2_stroke</item>
        <item name="android:layout_marginStart">8dp</item>
    </style>

    <style name="ThemeOverlay.Faznet.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!-- tvOS look for every dialog: big rounded corners, a bigger title, grey rounded fields, pill buttons -->
        <item name="alertDialogStyle">@style/Faznet.AlertDialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Faznet.DialogTitle</item>
        <item name="editTextStyle">@style/Faznet.EditText</item>
        <item name="radioButtonStyle">@style/Faznet.Choice.Radio</item>
        <item name="checkboxStyle">@style/Faznet.Choice.Check</item>
        <item name="buttonBarPositiveButtonStyle">@style/Faznet.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Faznet.DialogButton.Secondary</item>
        <item name="buttonBarNeutralButtonStyle">@style/Faznet.DialogButton.Secondary</item>
        <item name="colorControlHighlight">#660A84FF</item>
    </style>

    <style name="Faznet.AlertDialog" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearance">@style/ShapeAppearance.Faznet.Dialog</item>
    </style>

    <style name="ShapeAppearance.Faznet.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Faznet.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Faznet.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Faznet.Choice.Radio" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:background">@drawable/bg_choice</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="buttonTint">@color/accent</item>
    </style>

    <style name="Faznet.Choice.Check" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:background">@drawable/bg_choice</item>
        <item name="android:minHeight">48dp</item>
        <item name="buttonTint">@color/accent</item>
    </style>

    <!-- Red warning dialog (restart the device): has to be noticed over the picture -->
    <style name="Faznet.DialogButton.Alert" parent="Widget.Material3.Button">
        <item name="cornerRadius">22dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">46dp</item>
        <item name="backgroundTint">@color/alert_btn_bg</item>
        <item name="android:textColor">@color/alert_btn_text</item>
        <item name="strokeColor">#FFFFFF</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:layout_marginStart">8dp</item>
    </style>

    <style name="ThemeOverlay.Faznet.Dialog.Alert">
        <item name="colorSurface">#C62828</item>
        <item name="colorSurfaceContainerHigh">#C62828</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnSurfaceVariant">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#FFFFFF</item>
        <item name="colorSecondary">#FFFFFF</item>
        <item name="buttonBarPositiveButtonStyle">@style/Faznet.DialogButton.Alert</item>
        <item name="buttonBarNegativeButtonStyle">@style/Faznet.DialogButton.Alert</item>
        <item name="colorControlHighlight">#55FFFFFF</item>
    </style>

    <style name="Faznet.WindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fz_fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fz_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/fz_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/fz_fade_out</item>
    </style>

    <style name="Theme.Faznet.Player" parent="Theme.Faznet">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
