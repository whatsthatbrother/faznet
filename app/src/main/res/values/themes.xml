<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Faznet" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/accent2</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <!-- Dialogs, buttons and switches in the same blue-violet look (no default Material purple) -->
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_dim</item>
        <item name="colorSurfaceVariant">@color/surface2</item>
        <item name="colorSurfaceContainerLowest">@color/bg</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/dialog_bg</item>
        <item name="colorSurfaceContainerHighest">@color/surface2</item>
        <item name="colorPrimaryContainer">@color/surface2</item>
        <item name="colorOnPrimaryContainer">@color/text</item>
        <item name="colorSecondaryContainer">@color/accent</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>
        <item name="colorTertiary">@color/accent2</item>
        <item name="colorOutline">@color/line</item>
        <!-- Clickable things stand out: filled blue buttons, white when focused with the remote -->
        <item name="materialButtonStyle">@style/Faznet.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Faznet.Button.Secondary</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Faznet.Dialog</item>
        <!-- Short cross-fades between screens instead of the slow default slide -->
        <item name="android:windowAnimationStyle">@style/Faznet.WindowAnim</item>
        <item name="colorControlHighlight">#554F6BFF</item>
    </style>

    <style name="Faznet.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/btn_bg</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="iconTint">@color/btn_text</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="Faznet.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/btn2_bg</item>
        <item name="android:textColor">@color/btn2_text</item>
        <item name="iconTint">@color/btn2_text</item>
        <item name="strokeColor">@color/btn2_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Faznet.DialogButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/btn_bg</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:layout_marginStart">8dp</item>
    </style>

    <style name="Faznet.DialogButton.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/btn2_bg</item>
        <item name="android:textColor">@color/btn2_text</item>
        <item name="strokeColor">@color/btn2_stroke</item>
        <item name="android:layout_marginStart">8dp</item>
    </style>

    <style name="ThemeOverlay.Faznet.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Faznet.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Faznet.DialogButton.Secondary</item>
        <item name="buttonBarNeutralButtonStyle">@style/Faznet.DialogButton.Secondary</item>
        <item name="colorControlHighlight">#664F6BFF</item>
    </style>

    <style name="Faznet.WindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fz_fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fz_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/fz_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/fz_fade_out</item>
    </style>

    <style name="Theme.Faznet.Player" parent="Theme.Faznet">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/text</item>
    </style>
</resources>
