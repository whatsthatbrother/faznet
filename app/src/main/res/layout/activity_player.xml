<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:show_buffering="always" />

    <!-- Picture of the VLC engine (Settings → player engine) -->
    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/vlcLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false"
        android:visibility="gone" />

    <!-- Options bar (Menu key / tap): favorite, channel list, picture size, stats -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/infobar_pad"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/infobar_pad"
        android:paddingBottom="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/overlay_title"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnList"
            style="@style/IconButton"
            android:contentDescription="@string/channel_list"
            android:src="@drawable/ic_list" />

        <ImageButton
            android:id="@+id/btnFav"
            style="@style/IconButton"
            android:contentDescription="@string/favorite"
            android:src="@drawable/ic_star_border" />

        <ImageButton
            android:id="@+id/btnAspect"
            style="@style/IconButton"
            android:contentDescription="@string/aspect"
            android:src="@drawable/ic_aspect" />

        <ImageButton
            android:id="@+id/btnTracks"
            style="@style/IconButton"
            android:contentDescription="@string/tracks"
            android:src="@drawable/ic_tracks" />

        <ImageButton
            android:id="@+id/btnSleep"
            style="@style/IconButton"
            android:contentDescription="@string/sleep_timer"
            android:src="@drawable/ic_sleep" />

        <ImageButton
            android:id="@+id/btnPlaylistSwitch"
            style="@style/IconButton"
            android:contentDescription="@string/playlists_switch"
            android:src="@drawable/ic_playlist" />

        <ImageButton
            android:id="@+id/btnEngine"
            style="@style/IconButton"
            android:contentDescription="@string/engine"
            android:src="@drawable/ic_engine" />

        <ImageButton
            android:id="@+id/btnStats"
            style="@style/IconButton"
            android:contentDescription="@string/stats"
            android:src="@drawable/ic_stats" />
    </LinearLayout>

    <!-- Infobar: shown on every channel change, like a TV -->
    <LinearLayout
        android:id="@+id/infoPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_infobar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/infobar_pad"
        android:paddingTop="48dp"
        android:paddingEnd="@dimen/infobar_pad"
        android:paddingBottom="@dimen/infobar_pad"
        android:visibility="gone">

        <TextView
            android:id="@+id/infoNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:textColor="@color/accent"
            android:textSize="@dimen/infobar_number"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/infoLogo"
            android:layout_width="@dimen/infobar_logo_w"
            android:layout_height="@dimen/infobar_logo_h"
            android:layout_marginEnd="16dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/infoName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/infobar_name"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/infoGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_dim"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/infoEpg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#E6FFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/infoEpgProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="220dp"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="1000"
                android:progressTint="@color/accent"
                android:visibility="gone" />
        </LinearLayout>

        <TextClock
            android:id="@+id/infoClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/infobar_name" />
    </LinearLayout>

    <!-- Channel list over the picture (OK key): current group, Left/Right switches group -->
    <LinearLayout
        android:id="@+id/listPanel"
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_list_panel"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="16dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/listPrev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/prev_group"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_left" />

            <TextView
                android:id="@+id/listGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/overlay_title"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/listNext"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/next_group"
                android:padding="6dp"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <TextView
            android:id="@+id/listCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="6dp"
            android:background="#26FFFFFF" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listChannels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/listEpg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1AFFFFFF"
            android:ellipsize="end"
            android:maxLines="3"
            android:padding="10dp"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Clean start: shown while a channel is opening, until its picture runs smoothly -->
    <ProgressBar
        android:id="@+id/pbStart"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvNumberEntry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:background="@drawable/bg_panel"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_panel"
        android:fontFamily="monospace"
        android:padding="10dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_panel"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_panel"
        android:gravity="center"
        android:maxWidth="520dp"
        android:padding="16dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />
</FrameLayout>
