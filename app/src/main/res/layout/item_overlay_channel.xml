<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/overlay_row"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_overlay_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="14dp">

    <TextView
        android:id="@+id/ovNumber"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:gravity="center"
        android:textColor="@color/ov_dim"
        android:textSize="@dimen/overlay_number" />

    <ImageView
        android:id="@+id/ovLogo"
        android:layout_width="@dimen/overlay_logo_w"
        android:layout_height="@dimen/overlay_logo_h"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/ovName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:duplicateParentState="true"
        android:maxLines="1"
        android:textColor="@color/ov_text"
        android:textSize="@dimen/overlay_name" />

    <ImageView
        android:id="@+id/ovPlaying"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:importantForAccessibility="no"
        android:duplicateParentState="true"
        android:src="@drawable/ic_play_small"
        android:tint="@color/ov_playing"
        android:visibility="gone" />
</LinearLayout>
