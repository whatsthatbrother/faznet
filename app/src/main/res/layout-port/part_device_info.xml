<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvOpenSite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/device_open_site"
        android:textColor="@color/text_dim"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvUrl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:textColor="@color/accent"
        android:textIsSelectable="false"
        android:textSize="20sp"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:text="@string/device_mac"
        android:textAllCaps="true"
        android:textColor="@color/text_dim"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvMac"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:letterSpacing="0.04"
        android:textColor="@color/text"
        android:maxLines="1"
        android:textSize="24sp"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:text="@string/device_pin"
        android:textAllCaps="true"
        android:textColor="@color/text_dim"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:letterSpacing="0.3"
        android:textColor="@color/text"
        android:textSize="34sp"
        />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textColor="@color/text_dim"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnShowPin"
            android:minHeight="50dp"
            android:textAllCaps="false"
            app:cornerRadius="25dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/show_pin" />

        <Button
            android:id="@+id/btnSync"
            android:minHeight="50dp"
            android:textAllCaps="false"
            app:cornerRadius="25dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/device_sync" />

        <Button
            android:id="@+id/btnServer"
            android:minHeight="50dp"
            android:textAllCaps="false"
            app:cornerRadius="25dp"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/device_server" />

        <Button
            android:id="@+id/btnReset"
            android:minHeight="50dp"
            android:textAllCaps="false"
            app:cornerRadius="25dp"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/device_reset" />
    </LinearLayout>
</LinearLayout>
