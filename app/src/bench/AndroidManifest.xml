<?xml version="1.0" encoding="utf-8"?>
<!-- Only in the measuring build (-Pbench): no launcher icon, and a receiver the scripts in tools/ talk to. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity android:name="com.faznet.tv.ui.MainActivity">
            <intent-filter tools:node="removeAll" />
        </activity>

        <receiver
            android:name="com.faznet.tv.bench.BenchReceiver"
            android:exported="true" />
    </application>
</manifest>
